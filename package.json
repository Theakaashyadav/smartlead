{
  "name": "smartlead",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/prepare-browser.mjs && next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-production.mjs",
    "start:web": "node scripts/start-production.mjs --web-only",
    "config:check": "node scripts/check-config.mjs --production",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate && prisma generate --schema prisma/demo.prisma",
    "db:migrate": "tsx scripts/setup-mongodb.ts",
    "db:setup": "tsx scripts/setup-mongodb.ts",
    "demo:setup": "node scripts/setup-demo.mjs",
    "db:upgrade-organizations": "node scripts/upgrade-organizations.mjs",
    "feedback:local": "tsx scripts/upgrade-feedback.ts --allow-local",
    "feedback:local-clickable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-feedback.ps1",
    "feedback:refresh-links": "tsx scripts/refresh-feedback-links.ts",
    "seed": "tsx prisma/seed.ts",
    "worker": "node --import tsx src/worker.ts",
    "worker:check": "node --import tsx scripts/check-worker.ts",
    "package:hostinger": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-hostinger.ps1",
    "retention": "tsx scripts/retention.ts",
    "test": "vitest run",
    "test:mongodb": "vitest run --config vitest.mongo.config.ts",
    "test:e2e": "playwright test",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.3.0",
    "jose": "^6.1.0",
    "libphonenumber-js": "^1.12.24",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.21.0",
    "mongodb-connection-string-url": "^3.0.2",
    "next": "^16.0.0",
    "nodemailer": "^10.1.0",
    "otpauth": "^9.4.1",
    "pdfkit": "^0.17.2",
    "puppeteer": "^25.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.63.0",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.6",
    "whatsapp-web.js": "^1.34.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "mongodb-memory-server-core": "^10.4.3",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "puppeteer": "^25.13.0",
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.20.0",
    "basic-ftp": "^6.2.3",
    "uuid": "^11.1.1"
  }
}
