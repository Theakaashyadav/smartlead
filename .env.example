# SmartLead uses its own database on your existing MongoDB server.
DATABASE_PROVIDER=mongodb
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=smartlead
DEMO_MODE=false
APP_URL=http://127.0.0.1:3000
# Full Hostinger VPS deployment: your domain, without https:// or a path.
SMARTLEAD_DOMAIN=
# HOSTING: replace APP_URL with the site's exact https://domain (no /register path).
# Set variables in Hostinger's website Environment variables and click Apply changes.
# npm run config:check reports missing/invalid variable names without printing secrets.
# Optional legacy SQLite demo only: DATABASE_PROVIDER=sqlite and DEMO_MODE=true.
DEMO_DATABASE_URL=file:../data/demo.db
# Local testing: npm run feedback:local. Keep PUBLIC_FEEDBACK_URL empty.
# Hostinger deployment: set APP_URL to your public HTTPS domain.
# Optional separate feedback domain, served by the same hosted application.
PUBLIC_FEEDBACK_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional administrator seed; leave blank and use /register for an empty workspace.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_PIN=
# Managed hosting: true links the existing admin once when the deployed server starts.
# Remove ADMIN_PHONE_SETUP and ADMIN_PIN after successful setup.
ADMIN_PHONE_SETUP=false
# Optional when recovering a specific existing administrator with admin:phone.
ADMIN_USER_ID=
ADMIN_NAME=Workspace Admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to APP_URL + /api/integrations/google/callback. Register that exact URL in Google Cloud.
GOOGLE_REDIRECT_URI=
# Base64-encoded service account JSON; share each spreadsheet with its client_email.
GOOGLE_SERVICE_ACCOUNT_BASE64=
META_GRAPH_VERSION=v25.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_SESSION_DIR=
# Socket mode provides QR login without Chromium, including on managed hosting.
# Background mode loads the original site using server-side Chromium.
# Optional: native opens a desktop window; headless selects the legacy RemoteAuth provider.
WHATSAPP_LOGIN_MODE=socket
# npm start runs both the website and worker. Set this to persistent server storage.
SMARTLEAD_DATA_DIR=data
# Optional override; blank uses SMARTLEAD_DATA_DIR/whatsapp-web with npm start.
WHATSAPP_PROFILE_DIR=
# Used only by the legacy SQLite demo. MongoDB stores encrypted RemoteAuth backups.
WHATSAPP_REMOTE_AUTH_DIR=
# Leave empty on Windows to find installed Edge/Chrome automatically.
CHROME_PATH=
# Defaults to true on Linux to reduce browser processes on managed hosting. Set false on a VPS to use isolated browser contexts.
SHEET_EDITOR_LOW_RESOURCE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartLead <no-reply@example.com>
RETENTION_DAYS=365
CRON_SECRET=
