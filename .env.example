# Local: npm run demo:setup. Production: DEMO_MODE=false and PostgreSQL.
DEMO_MODE=true
DATABASE_URL=postgresql://smartlead:change-me@localhost:5432/smartlead
DEMO_DATABASE_URL=file:../data/demo.db
APP_URL=http://localhost:3000
# Local testing: npm run feedback:local. Keep PUBLIC_FEEDBACK_URL empty.
# Hostinger deployment: set APP_URL to your public HTTPS domain.
# Optional separate feedback domain, served by the same hosted application.
PUBLIC_FEEDBACK_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=replace-with-a-strong-database-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Workspace Admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Base64-encoded service account JSON; share each spreadsheet with its client_email.
GOOGLE_SERVICE_ACCOUNT_BASE64=
META_GRAPH_VERSION=v25.0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_SESSION_DIR=/app/data/sessions
# Background mode loads the original site without a visible browser window.
# Optional: native opens a desktop window; headless selects the legacy RemoteAuth provider.
WHATSAPP_LOGIN_MODE=background
WHATSAPP_PROFILE_DIR=/app/data/whatsapp-web
WHATSAPP_REMOTE_AUTH_DIR=/app/data/auth-archives
CHROME_PATH=/usr/bin/chromium
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartLead <no-reply@example.com>
RETENTION_DAYS=365
CRON_SECRET=
